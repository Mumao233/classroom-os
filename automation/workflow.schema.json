              "11b",
              "11c",
              "12a",
              "12b",
              "12c"
            ]
          },
          "uniqueItems": true
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "development": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "uniqueItems": true,
              "maxItems": 256
            },
            "enablement": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "uniqueItems": true,
              "maxItems": 256
            },
            "paid": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 6000
              },
              "uniqueItems": true,
              "maxItems": 256
            }
          },
          "required": [
            "development",
            "enablement",
            "paid"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "review_model": {
          "$ref": "#/$defs/model"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wall_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "max_calls": {
              "type": "integer",
              "minimum": 1
            },
            "max_repairs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "call_timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1200
            }
          },
          "required": [
            "wall_seconds",
            "max_calls",
            "max_repairs",
            "call_timeout_seconds"
          ]
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test"
          },
          "minItems": 1,
          "maxItems": 32,
          "contains": {
            "properties": {
              "kind": {
                "const": "trusted"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1
        },
        "audit": {
          "$ref": "#/$defs/audit"
        }
      },
      "required": [
        "goal",
        "acceptance",
        "review_criteria",
        "phase",
        "base",
        "branch",
        "title",
        "depends_on",
        "integration_depends_on",
        "paid_depends_on",
        "gates",
        "scope",
