{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phases.schema.json",
  "title": "Classroom OS roadmap phases",
  "description": "单字段格式规则。排序、引用存在、无环、history 与 status 一致等跨字段规则由 scripts/roadmap.py check 执行，见 SPEC.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phases",
    "edges"
  ],
  "properties": {
    "groups": {
      "type": "object",
      "propertyNames": {
        "pattern": "^\\d{2}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\"\\n]+$"
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hard"
      ],
      "properties": {
        "hard": {
          "$ref": "#/$defs/edgeList"
        },
        "integration": {
          "$ref": "#/$defs/edgeList"
        },
        "paid": {
          "$ref": "#/$defs/edgeList"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^\\d{2}[a-z]?$"
    },
    "status": {
      "enum": [
        "todo",
        "doing",
        "review",
        "done",
        "blocked"
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\"\\n]+$"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "prs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          }
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "status"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "status": {
                "$ref": "#/$defs/status"
              }
            }
          }
        }
      }
    },
    "edgeList": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "$ref": "#/$defs/id"
          },
          {
            "$ref": "#/$defs/id"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
